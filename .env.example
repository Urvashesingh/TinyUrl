# Copy to .env and adjust if needed. .env is gitignored.

# --- Phase 0: Postgres --------------------------------------------------
DATABASE_URL="postgresql://shortener:shortener@127.0.0.1:5432/shortener?schema=public"

PORT=3000

# Optional. Public origin used to build shortUrl in responses. Leave unset
# locally; set it in production so the value cannot be forged via the Host
# header. Example: BASE_URL="https://sho.rt"
# BASE_URL=

# Optional. Set to "true" when running behind a load balancer so Express reads
# X-Forwarded-Proto instead of assuming http.
# TRUST_PROXY=false

# Optional. Guard rails on the write path.
# MAX_URL_LENGTH=2048
# JSON_BODY_LIMIT=4kb

# --- Phase 1: Redis cache + logging -------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# How long a resolved link stays cached.
# CACHE_TTL_SECONDS=3600

# How long a "this code does not exist" answer stays cached. Much shorter,
# because it is a claim about absence and codes get created constantly.
# MISS_CACHE_TTL_SECONDS=30

# trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info
