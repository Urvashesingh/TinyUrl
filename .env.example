# Copy to .env and adjust if needed. .env is gitignored.

# --- Phase 0: Postgres --------------------------------------------------
DATABASE_URL="postgresql://shortener:shortener@127.0.0.1:5432/shortener?schema=public"

PORT=3000

# Optional. Public origin used to build shortUrl in responses. Leave unset
# locally; set it in production so the value cannot be forged via the Host
# header. Example: BASE_URL="https://sho.rt"
# BASE_URL=

# Optional. Set to "true" when running behind a load balancer so Express reads
# X-Forwarded-Proto instead of assuming http.
# TRUST_PROXY=false

# Optional. Guard rails on the write path.
# MAX_URL_LENGTH=2048
# JSON_BODY_LIMIT=4kb

# --- Phase 1: Redis cache + logging -------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# How long a resolved link stays cached.
# CACHE_TTL_SECONDS=3600

# How long a "this code does not exist" answer stays cached. Much shorter,
# because it is a claim about absence and codes get created constantly.
# MISS_CACHE_TTL_SECONDS=30

# trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info

# --- Phase 2: rate limiting ---------------------------------------------
# Creation is the abusable path: it writes a row and mints a public id.
# CREATE_RATE_LIMIT=20
# CREATE_RATE_WINDOW_SECONDS=60

# Redirects are the product; this blunts scanners rather than rationing use.
# REDIRECT_RATE_LIMIT=600
# REDIRECT_RATE_WINDOW_SECONDS=60

# --- Phase 3: click analytics -------------------------------------------
# MUST be set to something secret in production: an unsalted hash of an IPv4
# address is reversible, because the whole space is only 2^32.
IP_HASH_SALT="change-me-in-production"

# Consumer batching: flush on whichever trigger fires first.
# CLICK_BATCH_SIZE=100
# CLICK_BATCH_DELAY_MS=500

# --- Phase 4: Kafka -----------------------------------------------------
# "kafka" (durable, replayable, at-least-once) or "redis" (Phase 3 pub/sub,
# at-most-once -- loses everything published while no consumer is connected).
EVENT_TRANSPORT=kafka
KAFKA_BROKERS="localhost:9092"
# KAFKA_GROUP_ID=click-consumer
# Effectively permanent: raising it later rehashes keys to different
# partitions and breaks per-key ordering. It also caps consumer parallelism.
# CLICK_TOPIC_PARTITIONS=3

# --- Phase 5: trending leaderboard --------------------------------------
# Sliding window length, in one-minute buckets.
# TRENDING_WINDOW_MINUTES=10
# TRENDING_LIMIT=10
# How often the board is recomputed and pushed to every connected client.
# TRENDING_REFRESH_MS=2000

# --- Phase 6: read replica ----------------------------------------------
# Optional. Unset means reads go to the primary, which is a supported
# single-node deployment rather than a degraded one.
DATABASE_REPLICA_URL="postgresql://shortener:shortener@127.0.0.1:5433/shortener?schema=public"

# --- Phase 7: click_events partitioning ---------------------------------
# Run `npm run partitions` on a schedule. Provisioning ahead is what keeps
# the default partition empty, which matters -- see the Phase 7 notes.
# PARTITION_MONTHS_AHEAD=3
# CLICK_RETENTION_MONTHS=12

# --- Deployment profile -------------------------------------------------
# "full"    Redis, Kafka, WebSockets, background timers. Needs long-lived
#           processes: Docker Compose locally, or containers on a real host.
# "minimal" Postgres only -- create and redirect. This is what fits a
#           serverless platform, where a function answers one request and dies.
# APP_PROFILE=full

# Migrations need a direct connection. On Supabase, DATABASE_URL is the
# pooled endpoint (port 6543) and this is the direct one (port 5432); DDL and
# advisory locks do not survive a transaction-mode pooler. Locally they are
# the same database.
DIRECT_DATABASE_URL="postgresql://shortener:shortener@127.0.0.1:5432/shortener?schema=public"

# When set, POST /links requires it in an X-API-Key header. Redirects stay
# public. Set this on any public deployment: an open shortener gets found and
# used to launder phishing links behind your domain.
# CREATE_API_KEY=
