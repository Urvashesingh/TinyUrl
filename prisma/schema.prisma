generator client {
  provider = "prisma-client-js"
  // The container runs on Alpine (musl), the host is Windows/glibc. Prisma
  // ships a per-platform query engine, so both targets have to be generated or
  // the image starts and then fails on its first query.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection. On Supabase this is the pgbouncer endpoint (port 6543).
  // Serverless functions open a connection per instance, so an unpooled URL
  // exhausts Postgres long before traffic becomes interesting.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432). Migrations issue DDL and advisory locks,
  // neither of which survives a transaction-mode pooler.
  directUrl = env("DIRECT_DATABASE_URL")
}

model Link {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique
  longUrl   String
  createdAt DateTime @default(now())

  @@map("links")
}

/// One row per redirect served. Written by the analytics consumer, never by
/// the request path -- a redirect must not wait on analytics.
model ClickEvent {
  id         BigInt   @default(autoincrement())
  code       String
  occurredAt DateTime
  userAgent  String?
  referer    String?
  /// Salted hash, never the address itself. Enough to count unique visitors,
  /// not enough to identify one.
  ipHash     String?

  /// Postgres requires the partition key to appear in every unique constraint,
  /// so the primary key is (id, occurredAt) rather than id alone. That is the
  /// constraint that shapes the whole design -- see the Phase 7 notes.
  @@id([id, occurredAt])
  @@index([code, occurredAt])
  @@index([occurredAt])
  @@map("click_events")
}
