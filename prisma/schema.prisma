generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Link {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique
  longUrl   String
  createdAt DateTime @default(now())

  @@map("links")
}

/// One row per redirect served. Written by the analytics consumer, never by
/// the request path -- a redirect must not wait on analytics.
model ClickEvent {
  id         BigInt   @id @default(autoincrement())
  code       String
  occurredAt DateTime
  userAgent  String?
  referer    String?
  /// Salted hash, never the address itself. Enough to count unique visitors,
  /// not enough to identify one.
  ipHash     String?

  @@index([code, occurredAt])
  @@index([occurredAt])
  @@map("click_events")
}
